{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.haus/workspace/v1/schemas/shot-composition.json",
  "title": "Canonical one-level shot composition publication",
  "description": "Runtime-owned immutable publication envelope. Raw immutable containers preserve authored and opaque data. Compiled TimelineConfig semantics remain owned by @banodoco/timeline-schema.",
  "x-astrid-runtime-owner": "astrid-runtime",
  "x-astrid-runtime-canonical-timeline-owner": "@banodoco/timeline-schema",
  "x-astrid-runtime-generated-boundary": "Use the pinned TimelineConfig only for compiled data; raw containers reuse compatible common fields without requiring Player completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "timeline_id", "expected_head", "parent_composition"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "timeline_id": { "type": "string", "minLength": 1 },
    "expected_head": { "type": ["string", "null"] },
    "parent_revision_id": { "type": "string", "minLength": 1 },
    "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "parent_composition": { "$ref": "#/$defs/ParentComposition" },
    "shot_revisions": { "type": "array", "items": { "$ref": "#/$defs/ShotRevisionInput" } },
    "internal_timeline_revisions": { "type": "array", "items": { "$ref": "#/$defs/InternalTimelineRevisionInput" } },
    "dependency_manifest": { "$ref": "#/$defs/DependencyManifest" }
  },
  "$defs": {
    "RawTimelinePayload": {
      "type": "object",
      "description": "Main immutable authoring payload, not a compiled Player configuration. Known containers are typed; missing fields, explicit opaque nulls and unknown siblings are preserved. Agent validates and compiles command/document/timing/reference semantics.",
      "additionalProperties": true,
      "properties": {
        "theme": {
          "$ref": "timeline-config.schema.json#/properties/theme"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawTrack"
          }
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawClip"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenMap"
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenMap"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRecord"
          }
        },
        "layout": {
          "$ref": "#/$defs/OpenMap"
        },
        "registry": {
          "type": "object",
          "properties": {
            "assets": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/AssetRecord" }
            }
          },
          "additionalProperties": true
        },
        "output": {
          "$ref": "#/$defs/RawOutput"
        },
        "playback": {
          "$ref": "#/$defs/OpenMap"
        },
        "meta": {
          "$ref": "timeline-config.schema.json#/definitions/Meta"
        }
      }
    },
    "RawTrack": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "timeline-config.schema.json#/properties/tracks/items/properties/id"
        },
        "kind": {
          "$ref": "timeline-config.schema.json#/properties/tracks/items/properties/kind"
        },
        "label": {
          "$ref": "timeline-config.schema.json#/properties/tracks/items/properties/label"
        },
        "role": {
          "$ref": "timeline-config.schema.json#/properties/tracks/items/properties/role"
        },
        "volume": {
          "anyOf": [
            { "$ref": "timeline-config.schema.json#/properties/tracks/items/properties/volume" },
            { "type": "null" }
          ]
        },
        "meta": {
          "$ref": "timeline-config.schema.json#/definitions/Meta"
        }
      }
    },
    "RawClip": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "timeline-config.schema.json#/definitions/TimelineClip/properties/id"
        },
        "track": {
          "$ref": "timeline-config.schema.json#/definitions/TimelineClip/properties/track"
        },
        "clipType": {
          "$ref": "timeline-config.schema.json#/definitions/TimelineClip/properties/clipType"
        },
        "effects": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OpenMap"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        },
        "meta": {
          "$ref": "timeline-config.schema.json#/definitions/Meta"
        }
      }
    },
    "RawOutput": {
      "type": "object",
      "additionalProperties": true,
      "description": "Authored output may be partial. Frame rate representations are preserved; Agent owns their timing semantics.",
      "properties": {
        "fps": {
          "anyOf": [
            { "type": "number" },
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "numerator": { "type": "number" },
                "denominator": { "type": "number" }
              }
            },
            { "type": "array", "items": { "type": "number" } }
          ]
        },
        "resolution": { "$ref": "timeline-config.schema.json#/definitions/TimelineOutput/properties/resolution" },
        "file": { "$ref": "timeline-config.schema.json#/definitions/TimelineOutput/properties/file" },
        "background": { "$ref": "timeline-config.schema.json#/definitions/TimelineOutput/properties/background" },
        "background_scale": { "$ref": "timeline-config.schema.json#/definitions/TimelineOutput/properties/background_scale" }
      }
    },
    "OpenMap": {
      "type": "object",
      "additionalProperties": true
    },
    "ParentComposition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["config", "registry", "clips", "occurrences"],
      "properties": {
        "config": {
          "$ref": "#/$defs/RawTimelinePayload",
          "description": "Exact authored parent config; partial output and opaque fields are preserved."
        },
        "registry": {
          "type": "object",
          "description": "Runtime-managed media registry carried by the publication envelope; Runtime-specific and outside the canonical TimelineConfig owned by @banodoco/timeline-schema.",
          "x-astrid-runtime-schema-owner": "astrid-runtime#ManagedMediaRegistry",
          "properties": {
            "assets": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/AssetRecord" }
            }
          },
          "additionalProperties": true
        },
        "clips": {
          "type": "array",
          "description": "Raw authored ordinary clips; Agent owns command, timing and reference validation.",
          "items": { "$ref": "#/$defs/RawClip" }
        },
        "occurrences": { "type": "array", "items": { "$ref": "#/$defs/Occurrence" } },
        "meta": { "$ref": "timeline-config.schema.json#/definitions/Meta" }
      }
    },
    "Occurrence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["occurrence_id", "shot_id", "shot_revision_id", "placement", "duration_ms", "track"],
      "properties": {
        "occurrence_id": { "type": "string", "minLength": 1 },
        "shot_id": { "type": "string", "minLength": 1 },
        "shot_revision_id": { "type": "string", "minLength": 1 },
        "placement": { "type": "object", "additionalProperties": true },
        "source_offset": {},
        "duration_ms": { "type": "integer", "exclusiveMinimum": 0 },
        "speed": {},
        "track": { "type": "string", "minLength": 1 },
        "transform": { "type": "object", "additionalProperties": true },
        "gain": { "type": "number" },
        "mute": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/OpenMap" },
        "meta": { "$ref": "timeline-config.schema.json#/definitions/Meta" }
      }
    },
    "ShotRevisionInput": {
      "type": "object",
      "additionalProperties": true,
      "required": ["shot_id", "revision_id", "internal_timeline_revision_id", "payload"],
      "properties": {
        "shot_id": { "type": "string", "minLength": 1 },
        "revision_id": { "type": "string", "minLength": 1 },
        "internal_timeline_revision_id": { "type": "string", "minLength": 1 },
        "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "payload": { "$ref": "#/$defs/ShotPayload" }
      }
    },
    "ShotPayload": {
      "type": "object",
      "description": "Open shot payload. Only the cross-consumer core is typed; all unknown sibling and nested extension fields remain lossless.",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical name for new writes. Reads may fall back through provenance/metadata name/title aliases and then stable shot identity."
        },
        "metadata": { "$ref": "#/$defs/OpenMap" },
        "provenance": { "$ref": "#/$defs/OpenMap" },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/ShotAsset" }
        },
        "audio_bindings": {
          "type": "array",
          "description": "Actual child audio bindings; authoritative with child audio clips for playback. Optional and never derived from the legacy aggregate audio descriptor.",
          "items": { "$ref": "#/$defs/OpenBinding" }
        },
        "text_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpenBinding" }
        },
        "audio": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional legacy aggregate audio descriptor. Read when present, preserve as authored, and never require, fabricate, or collapse it from child audio clips/bindings."
        },
        "timing": {
          "type": "object",
          "additionalProperties": true,
          "description": "Open timing metadata. Visible-duration semantics remain at the canonical timeline/consumer boundary."
        },
        "internal_timeline_revision_id": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable link to the child timeline revision."
        },
        "meta": {
          "$ref": "timeline-config.schema.json#/definitions/Meta"
        }
      }
    },
    "ShotAsset": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "object_id": { "type": "string", "minLength": 1 },
        "media_id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "role": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "media_kind": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/OpenMap" },
        "meta": { "$ref": "timeline-config.schema.json#/definitions/Meta" }
      }
    },
    "AssetRecord": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "meta": { "$ref": "timeline-config.schema.json#/definitions/Meta" }
      }
    },
    "OpenBinding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "clip_id": { "type": "string", "minLength": 1 },
        "track_id": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "media_id": { "type": "string", "minLength": 1 },
        "object_id": { "type": "string", "minLength": 1 }
      }
    },
    "InternalTimelineRevisionInput": {
      "type": "object",
      "additionalProperties": true,
      "required": ["timeline_id", "revision_id", "payload"],
      "properties": {
        "timeline_id": { "type": "string", "minLength": 1 },
        "revision_id": { "type": "string", "minLength": 1 },
        "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "payload": {
          "$ref": "#/$defs/RawTimelinePayload",
          "description": "Exact main immutable internal payload, including authored and opaque siblings."
        }
      }
    },
    "DependencyManifest": {
      "type": "object",
      "properties": {
        "media": { "type": "array" },
        "shots": { "type": "array" },
        "internal_timelines": { "type": "array" },
        "timelines": { "type": "array" },
        "documents": { "type": "array", "items": { "$ref": "timeline-commit.json#/$defs/DocumentPin" } }
      }
    }
  }
}
