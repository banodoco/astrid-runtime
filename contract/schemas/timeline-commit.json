          "type": "string",
          "minLength": 1
        },
        "timeline_id": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "$ref": "#/$defs/CommitRevisionQuery"
        }
      },
      "returns": {
        "type": "array",
