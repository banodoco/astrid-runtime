#!/usr/bin/env bash
# One pre-push command (testing plan R-12): the default run, plus a reminder when R-11 paths changed.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
else
  PY=python3
fi
"$PY" -m pytest -q

changed=$({ git diff --name-only origin/main...HEAD 2>/dev/null || true; git diff --name-only HEAD; } | sort -u)
if printf '%s\n' "$changed" | grep -qE '^(runtime_protocol|astrid_runtime)/'; then
  echo "Runtime protocol changed: run the Astrid smoke journey before merging (testing plan R-11)."
fi
