#!/usr/bin/env bash
# Fast pre-push safety checks. Full pytest, integration, native, and journey
# coverage remains in CI; this command only checks files involved in this push.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [ -n "${PYTHON_BIN:-}" ]; then PY=$PYTHON_BIN
elif [ -x .venv/bin/python ]; then PY=.venv/bin/python
else PY=python3
fi

usage() { echo "usage: $0 [--native-provider-smoke] [remote-name remote-url] < local-ref local-sha remote-ref remote-sha" >&2; }

readonly SMOKE_NODES=(
  "tests/test_timeline_native_asset_union.py::test_genuine_native_capture_is_retained_with_lossless_union[raw]"
  "tests/test_timeline_native_asset_union.py::test_disjoint_clip_merge_and_guarded_undo_preserve_explicit_scopes[raw-None]"
)

run_python_bounded() {
  "$PY" -B - "$@" <<'PY'
import subprocess, sys
try:
    result = subprocess.run([sys.executable, *sys.argv[1:]], check=False, timeout=45)
except subprocess.TimeoutExpired:
    print("native provider smoke command exceeded 45 seconds", file=sys.stderr)
    raise SystemExit(124)
raise SystemExit(result.returncode)
PY
}

run_native_provider_smoke() {
  if [ -z "${ASTRID_CHECKOUT:-}" ]; then echo "native provider smoke requires ASTRID_CHECKOUT" >&2; return 2; fi
  local checkout
  checkout=$(cd -- "$ASTRID_CHECKOUT" 2>/dev/null && pwd -P) || { echo "native provider smoke checkout is unavailable: $ASTRID_CHECKOUT" >&2; return 2; }
  if [ ! -f "$checkout/astrid/core/execution/generic_host.py" ] || [ ! -f "$checkout/astrid/sdk/timeline/commit.py" ]; then
    echo "native provider smoke requires an Astrid checkout with the Agent provider" >&2; return 2
  fi
  local provider_probe='import inspect, os
from pathlib import Path
from astrid.sdk.timeline import commit
checkout = Path(os.environ["ASTRID_CHECKOUT"]).resolve()
factory = getattr(commit, "create_runtime_commit_service", None)
if not callable(factory): raise SystemExit("Agent provider factory is unavailable")
origin = Path(inspect.getfile(factory)).resolve()
if not origin.is_relative_to(checkout): raise SystemExit(f"Agent provider origin is outside ASTRID_CHECKOUT: {origin}")
provider = factory()
if getattr(provider, "provider_id", None) != "astrid-v1": raise SystemExit("Agent provider identity is not astrid-v1")
print(f"verified Agent provider origin: {origin}")'
  PYTHONDONTWRITEBYTECODE=1 ASTRID_CHECKOUT="$checkout" PYTHONPATH="$checkout:$PWD/packages/python:$PWD${PYTHONPATH:+:$PYTHONPATH}" run_python_bounded -c "$provider_probe"
  local collected
  collected=$(PYTHONDONTWRITEBYTECODE=1 ASTRID_CHECKOUT="$checkout" PYTHONPATH="$checkout:$PWD/packages/python:$PWD${PYTHONPATH:+:$PYTHONPATH}" run_python_bounded -m pytest --collect-only -q -o addopts= -p no:cacheprovider "${SMOKE_NODES[@]}") || { echo "native provider smoke could not collect its required D101 nodes" >&2; return 2; }
  local node
  for node in "${SMOKE_NODES[@]}"; do
    grep -Fqx -- "$node" <<<"$collected" || { echo "native provider smoke selected node is missing: $node" >&2; return 2; }
  done
  local selected_count
  selected_count=$(grep -E -c '^tests/test_timeline_native_asset_union\.py::' <<<"$collected" || true)
  [ "$selected_count" -eq "${#SMOKE_NODES[@]}" ] || { echo "native provider smoke selected $selected_count D101 nodes; expected ${#SMOKE_NODES[@]}" >&2; return 2; }
  local smoke_output="" smoke_status=0
  smoke_output=$(PYTHONDONTWRITEBYTECODE=1 ASTRID_CHECKOUT="$checkout" PYTHONPATH="$checkout:$PWD/packages/python:$PWD${PYTHONPATH:+:$PYTHONPATH}" run_python_bounded -m pytest -q -ra -o addopts= -p no:cacheprovider "${SMOKE_NODES[@]}") || smoke_status=$?
  printf '%s\n' "$smoke_output"
  [ "$smoke_status" -eq 0 ] || return "$smoke_status"
  if grep -Eq '(^|[[:space:],])[0-9]+ (skipped|deselected|xfailed|xpassed)' <<<"$smoke_output"; then
    echo "native provider smoke cannot pass with skipped or non-executed tests" >&2; return 2
  fi
}

changed_files() {
  if [ "$#" -eq 2 ]; then
    while read -r _local_ref local_sha _remote_ref remote_sha; do
      [ -n "${local_sha:-}" ] || continue
      if [[ "$remote_sha" =~ ^0+$ ]]; then
        found_base=0
        for base_ref in refs/remotes/origin/int/r1 refs/remotes/origin/main refs/remotes/origin/release-1; do
          if git merge-base --is-ancestor "$base_ref" "$local_sha" 2>/dev/null; then git diff --name-only "$base_ref" "$local_sha"; found_base=1; break; fi
        done
        [ "$found_base" -eq 1 ] || git diff-tree --root --no-commit-id --name-only -r "$local_sha"
      else git diff --name-only "$remote_sha" "$local_sha"; fi
    done
    return
  fi
  if git rev-parse --verify --quiet origin/main >/dev/null; then git diff --name-only origin/main...HEAD; fi
  git diff --name-only HEAD
  git ls-files --others --exclude-standard
}

run_changed_checks() {
  mapfile -t changed < <(changed_files "$@" | sed '/^$/d' | sort -u)
  if [ "${#changed[@]}" -eq 0 ]; then echo "pre-push: no changed files; full suites remain in CI"; return 0; fi
  mapfile -t python_files < <(printf '%s\n' "${changed[@]}" | awk '/\.py$/')
  if [ "${#python_files[@]}" -gt 0 ]; then
    PYTHONDONTWRITEBYTECODE=1 "$PY" - "${python_files[@]}" <<'PY'
import ast, pathlib, sys
for name in sys.argv[1:]:
    path = pathlib.Path(name)
    if not path.is_file(): continue
    try: ast.parse(path.read_text(encoding="utf-8"), filename=name)
    except (OSError, SyntaxError) as error:
        print(f"Python syntax check failed: {name}: {error}", file=sys.stderr); raise SystemExit(1)
PY
    ruff_bin=${RUFF_BIN:-}
    [ -n "$ruff_bin" ] || { [ -x .venv/bin/ruff ] && ruff_bin=.venv/bin/ruff || ruff_bin=$(command -v ruff || true); }
    [ -n "$ruff_bin" ] || { echo "pre-push: changed Python files require Ruff for lint/format checks" >&2; return 2; }
    "$ruff_bin" check --no-cache "${python_files[@]}"
    "$ruff_bin" format --check --no-cache "${python_files[@]}"
    mapfile -t test_files < <(printf '%s\n' "${python_files[@]}" | awk '/^tests\/test_.*\.py$/')
    if [ "${#test_files[@]}" -gt 0 ]; then
      "$PY" -m pytest --version >/dev/null 2>&1 || { echo "pre-push: changed test files require pytest; full suites remain in CI" >&2; return 2; }
      timeout --signal=TERM 7 "$PY" -m pytest -q --maxfail=1 "${test_files[@]}"
    fi
  fi
  if printf '%s\n' "${changed[@]}" | grep -qE '^(runtime_protocol|astrid_runtime)/'; then
    echo "pre-push: Runtime protocol changed; native-provider smoke is deferred to CI" >&2
  fi
  echo "pre-push: checked ${#changed[@]} changed file(s); full suites remain in CI"
}

case "${1:-}" in
  --native-provider-smoke) [ "$#" -eq 1 ] || { usage; exit 2; }; run_native_provider_smoke ;;
  -h|--help) usage ;;
  "") run_changed_checks ;;
  *) [ "$#" -eq 2 ] || { usage; exit 2; }; run_changed_checks "$@" ;;
esac
